{
  "name": "iShop 01 - Cargar conocimiento RAG",
  "nodes": [
    {
      "id": "5858fa1d-711c-4912-a3ad-9782e80ddafe",
      "name": "INSTRUCCIONES",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [120, -140],
      "parameters": {
        "width": 920,
        "height": 220,
        "content": "## Cargar documentos a Qdrant\n\n1. Asigna la credencial **Google Gemini(PaLM) Api** al nodo de embeddings.\n2. Asigna la credencial **QdrantApi** con URL `http://qdrant:6333` al Vector Store.\n3. Activa el workflow y abre la URL de producción del formulario.\n4. Sube los archivos de `chatbot/knowledge/` excepto `preguntas-prueba.md`."
      }
    },
    {
      "id": "3e88d241-2b14-4ba4-b5a3-75deefb80232",
      "name": "Cargar documento",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [160, 160],
      "webhookId": "9425eec0-8c05-4b17-b16d-5146169d55df",
      "parameters": {
        "formTitle": "Cargar conocimiento de iShop",
        "formDescription": "Sube un archivo para añadirlo a la base RAG del chatbot.",
        "formFields": {
          "values": [
            {
              "fieldType": "file",
              "fieldLabel": "Archivo",
              "requiredField": true
            },
            {
              "fieldType": "dropdown",
              "fieldLabel": "Categoría",
              "fieldOptions": {
                "values": [
                  {"option": "Catálogo"},
                  {"option": "Ventas y envíos"},
                  {"option": "Garantía"},
                  {"option": "Servicio técnico"},
                  {"option": "Tiendas"},
                  {"option": "Reglas del asistente"}
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "bc10debb-db0c-42a0-b8eb-2d5ee036d132",
      "name": "Qdrant - Insertar documentos",
