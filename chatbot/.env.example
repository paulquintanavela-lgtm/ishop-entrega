# Copia este archivo como .env. start.sh lo crea solo si falta.
GENERIC_TIMEZONE=America/Guayaquil

# Chatwoot local. start.sh genera CHATWOOT_SECRET_KEY_BASE si está vacío.
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_POSTGRES_PASSWORD=ishop_chatwoot_local
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_ACCESS_TOKEN=
CHATWOOT_BOT_TOKEN=

# Las claves de Gemini y del correo NO se guardan aquí.
# Se agregan desde n8n en Settings > Credentials.
