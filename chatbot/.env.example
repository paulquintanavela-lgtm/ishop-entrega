# Copia este archivo como .env. start.sh lo crea solo si falta.
GENERIC_TIMEZONE=America/Guayaquil

# Chatwoot local. start.sh genera CHATWOOT_SECRET_KEY_BASE si está vacío.
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_POSTGRES_PASSWORD=ishop_chatwoot_local
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_ACCESS_TOKEN=
CHATWOOT_BOT_TOKEN=
# Correo del asesor que recibe los traspasos. Si está vacío, se asigna al
# primer administrador de la cuenta.
CHATWOOT_HUMAN_AGENT_EMAIL=

# Opcional. Si está vacío, n8n usa la credencial de Gemini.
# El workflow 04 la usa para responder sin el "pensamiento" lento.
GEMINI_API_KEY=
